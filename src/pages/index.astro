}
var statCurrent = { before: 0, after: 0, f1: 0 };
function formatPercent(lang, value) {
  var fixed = value.toFixed(2).replace(".", lang === "tr" ? "," : ".");
  return lang === "tr" ? "%" + fixed : fixed + "%";
}
function refreshResearchStatValues() {
  var valBefore = document.getElementById("val-before");
  var valAfter = document.getElementById("val-after");
  var valF1 = document.getElementById("val-f1");
  if (!valBefore) return;
  valBefore.textContent = formatPercent(currentLang, statCurrent.before);
  valAfter.textContent = formatPercent(currentLang, statCurrent.after);
  valF1.textContent = formatPercent(currentLang, statCurrent.f1);
}
function animateResearchStats() {
  var attackBefore = 95.19, attackAfter = 0.48, f1 = 83.81;
  var barBefore = document.getElementById("bar-before");
  var barAfter = document.getElementById("bar-after");

  function render(vb, va, vf) {
    statCurrent.before = vb;
    statCurrent.after = va;
    statCurrent.f1 = vf;
    barBefore.style.width = vb + "%";
    barAfter.style.width = va + "%";
    refreshResearchStatValues();
  }

  if (reduceMotion) {
    render(attackBefore, attackAfter, f1);
    return;
  }
  var duration = 750;
  var start = null;
  function step(ts) {
    if (start === null) start = ts;
    var progress = Math.min(1, (ts - start) / duration);
    render(attackBefore * progress, attackAfter * progress, f1 * progress);
    if (progress < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}
function initResearchObserver() {
  var section = document.getElementById("research");
  var done = false;
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting && !done) {
        done = true;
        animateResearchStats();
        io.disconnect();
      }
    });
  }, { threshold: 0.3 });
  io.observe(section);
}

/* ---------------- inventory ---------------- */
var TAB_KEYS = ["backend", "frontend", "architectureSecurity", "aiml", "databases", "tools"];
function buildInventory() {
  var tablist = document.getElementById("skill-tablist");
  var panelsWrap = document.getElementById("skill-panels");
  TAB_KEYS.forEach(function (key, idx) {
    var tabBtn = document.createElement("button");
    tabBtn.type = "button";
    tabBtn.className = "tab-btn";
    tabBtn.id = "tab-" + key;
    tabBtn.setAttribute("role", "tab");
    tabBtn.setAttribute("aria-selected", idx === 0 ? "true" : "false");
    tabBtn.setAttribute("aria-controls", "panel-" + key);
    tabBtn.tabIndex = idx === 0 ? 0 : -1;
    bindText(tabBtn, function (l) { return get(content[l], "inventory.tabs." + key + ".label"); });
    tabBtn.addEventListener("click", function () { activateTab(key); });
    tablist.appendChild(tabBtn);

    var panel = document.createElement("div");
    panel.className = "tabpanel reveal";
    panel.id = "panel-" + key;
    panel.setAttribute("role", "tabpanel");
    panel.setAttribute("aria-labelledby", "tab-" + key);
    panel.tabIndex = 0;
    if (idx !== 0) panel.hidden = true;
    var grid = makeEl("div", "skill-grid");
    var items = content.tr.inventory.tabs[key].items;
    var visibleCap = 6;
    var extraChips = [];
    items.forEach(function (item, itemIdx) {
      var chip = document.createElement("button");
      chip.type = "button";
      chip.className = "skill-chip";
      chip.textContent = item;
      chip.addEventListener("click", function () { setTechFilter(item); });
      if (itemIdx >= visibleCap) {
        chip.hidden = true;
        extraChips.push(chip);
      }
      grid.appendChild(chip);
    });
    if (items.length > visibleCap) {
      var extraCount = items.length - visibleCap;
      var moreExpanded = false;
      var moreBtn = document.createElement("button");
      moreBtn.type = "button";
      moreBtn.className = "skill-chip skill-chip-more";
      moreBtn.setAttribute("aria-expanded", "false");
      function refreshMoreLabel(l) {
        return moreExpanded ? (l === "tr" ? "Daha az göster" : "Show fewer") : (l === "tr" ? ("+" + extraCount + " daha") : ("+" + extraCount + " more"));
      }
      bindText(moreBtn, refreshMoreLabel);
      moreBtn.addEventListener("click", function () {
        moreExpanded = !moreExpanded;
        moreBtn.setAttribute("aria-expanded", String(moreExpanded));
        extraChips.forEach(function (c) { c.hidden = !moreExpanded; });
        moreBtn.textContent = refreshMoreLabel(currentLang);
      });
      grid.appendChild(moreBtn);
    }
    panel.appendChild(grid);
    panelsWrap.appendChild(panel);
  });

  tablist.addEventListener("keydown", function (e) {
    var idx = TAB_KEYS.indexOf(document.activeElement.id.replace("tab-", ""));
    if (idx === -1) return;
    var newIdx = idx;
    if (e.key === "ArrowRight") newIdx = (idx + 1) % TAB_KEYS.length;
    else if (e.key === "ArrowLeft") newIdx = (idx - 1 + TAB_KEYS.length) % TAB_KEYS.length;
    else if (e.key === "Home") newIdx = 0;
    else if (e.key === "End") newIdx = TAB_KEYS.length - 1;
    else return;
    e.preventDefault();
    activateTab(TAB_KEYS[newIdx]);
    document.getElementById("tab-" + TAB_KEYS[newIdx]).focus();
  });
}
function activateTab(key) {
  TAB_KEYS.forEach(function (k) {
    var isActive = k === key;
    var tabBtn = document.getElementById("tab-" + k);
    var panel = document.getElementById("panel-" + k);
    tabBtn.setAttribute("aria-selected", isActive ? "true" : "false");
    tabBtn.tabIndex = isActive ? 0 : -1;
    panel.hidden = !isActive;
  });
}

