/* ---------------- helpers ---------------- */
var i18nRefs = [];
var currentLang = "tr";
var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
var scenePaused = false;

function get(obj, path) {
  var parts = path.split(".");
  var cur = obj;
  for (var i = 0; i < parts.length; i++) {
    if (cur == null) return "";
    cur = cur[parts[i]];
  }
  return cur == null ? "" : cur;
}

function bindText(node, getter) {
  i18nRefs.push({ node: node, type: "text", getter: getter });
  node.textContent = getter(currentLang);
}
function bindAttr(node, attr, getter) {
  i18nRefs.push({ node: node, type: "attr", attr: attr, getter: getter });
  node.setAttribute(attr, getter(currentLang));
}
function bindAllStaticI18n() {
  document.querySelectorAll("[data-i18n]").forEach(function (el) {
    var path = el.getAttribute("data-i18n");
    bindText(el, function (l) { return get(content[l], path); });
  });
  document.querySelectorAll("[data-i18n-aria]").forEach(function (el) {
    var path = el.getAttribute("data-i18n-aria");
    bindAttr(el, "aria-label", function (l) { return get(content[l], path); });
  });
}
function makeEl(tag, className, text) {
  var e = document.createElement(tag);
  if (className) e.className = className;
  if (text != null) e.textContent = text;
  return e;
}

function themeIsDark() {
  var attr = document.documentElement.getAttribute("data-theme");
  if (attr === "dark") return true;
  if (attr === "light") return false;
  return window.matchMedia("(prefers-color-scheme: dark)").matches;
}
function cssVar(name) { return getComputedStyle(document.documentElement).getPropertyValue(name).trim(); }
function px(ctx, x, y, color) { ctx.fillStyle = color; ctx.fillRect(Math.floor(x), Math.floor(y), 1, 1); }
function makeCanvas(id, gridW, gridH, cell) {
  var canvas = document.getElementById(id);
  var dpr = Math.max(1, Math.round(Math.min(window.devicePixelRatio || 1, 2)));
  canvas.width = gridW * cell * dpr;
  canvas.height = gridH * cell * dpr;
  canvas.style.width = "100%";
  canvas.style.height = "auto";
  canvas.setAttribute("aria-hidden", "true");
  var ctx = canvas.getContext("2d");
  ctx.imageSmoothingEnabled = false;
  ctx.scale(cell * dpr, cell * dpr);
  return { ctx: ctx, gridW: gridW, gridH: gridH };
}

/* ---------------- scene (canvas) ---------------- */
var GRID_W = 56, GRID_H = 32;
var sceneStars = null;
function ensureStars() {
  if (sceneStars) return sceneStars;
  sceneStars = [];
  var minX = 33, maxX = 51, minY = 4, maxY = 13, minDist = 3.5;
  var moonCx = 46.5, moonCy = 7.5, moonAvoid = 4;
  var mullionX = 41, mullionY = 9, mullionAvoid = 1;
  var attempts = 0;
  while (sceneStars.length < 10 && attempts < 1500) {
    attempts++;
    var x = minX + Math.random() * (maxX - minX);
    var y = minY + Math.random() * (maxY - minY);
    if (Math.hypot(x - moonCx, y - moonCy) < moonAvoid) continue;
    if (Math.abs(x - mullionX) < mullionAvoid || Math.abs(y - mullionY) < mullionAvoid) continue;
    var tooClose = false;
    for (var i = 0; i < sceneStars.length; i++) {
      var dx = sceneStars[i].x - x, dy = sceneStars[i].y - y;
      if (dx * dx + dy * dy < minDist * minDist) { tooClose = true; break; }
    }
    if (tooClose) continue;
    sceneStars.push({ x: x, y: y, size: 1, phase: Math.random() * Math.PI * 2 });
  }
  return sceneStars;
}

function drawScene(scene, t) {
  var ctx = scene.ctx, w = scene.gridW, h = scene.gridH;
  var dark = themeIsDark();
  var ink = "#1D2B53";
  var roomWall = dark ? "#141A33" : "#F6E4D8";
  var roomFloor = dark ? "#0F1428" : "#EAD6C4";
  var deskColor = dark ? "#6B4A3A" : "#A9724F";
  var deskDark = dark ? "#4E3527" : "#8A5B3C";
  var monitorFrame = dark ? "#0B0F1F" : "#1D2B53";
  var accent = cssVar("--accent") || "#FF3E7A";
  var led = cssVar("--led") || "#14C15A";
  var skyTop = dark ? "#0B1030" : "#8ED8FF";
  var skyBottom = dark ? "#232A55" : "#CDEBFF";

  ctx.fillStyle = roomWall;
  ctx.fillRect(0, 0, w, h);
  ctx.fillStyle = roomFloor;
  ctx.fillRect(0, h - 8, w, 8);

  var wx = 32, wy = 3, ww = 20, wh = 14;
  ctx.fillStyle = ink;
  ctx.fillRect(wx - 1, wy - 1, ww + 2, wh + 2);
  var skyGrad = ctx.createLinearGradient(0, wy, 0, wy + wh);
  skyGrad.addColorStop(0, skyTop);
  skyGrad.addColorStop(1, skyBottom);
  ctx.fillStyle = skyGrad;
  ctx.fillRect(wx, wy, ww, wh);

  if (dark) {
    var stars = ensureStars();
    var starDim = [138, 143, 163], starBright = [253, 243, 233];
    for (var i = 0; i < stars.length; i++) {
      var s = stars[i];
      var tw = reduceMotion ? 1 : (Math.sin(t / 900 + s.phase) + 1) / 2;
      var r = Math.round(starDim[0] + (starBright[0] - starDim[0]) * tw);
      var g = Math.round(starDim[1] + (starBright[1] - starDim[1]) * tw);
      var b = Math.round(starDim[2] + (starBright[2] - starDim[2]) * tw);
      ctx.fillStyle = "rgb(" + r + "," + g + "," + b + ")";
      ctx.fillRect(Math.floor(s.x), Math.floor(s.y), s.size, s.size);
    }
    var mx = wx + ww - 8, my = wy + 2;
    ctx.fillStyle = "#FDF3E9";
    ctx.fillRect(mx + 1, my, 3, 5);
    ctx.fillRect(mx, my + 1, 5, 3);
    ctx.fillStyle = "#D9CDB4";
    ctx.fillRect(mx + 1, my + 2, 1, 1);
    ctx.fillRect(mx + 3, my + 3, 1, 1);
  } else {
    ctx.fillStyle = "#FFE07A";
    ctx.fillRect(wx + ww - 8, wy + 2, 5, 5);
    ctx.fillStyle = "#FFFFFF";
    ctx.fillRect(wx + 2, wy + 4, 6, 2);
    ctx.fillRect(wx + 3, wy + 3, 4, 1);
    ctx.fillRect(wx + 9, wy + 7, 7, 2);
    ctx.fillRect(wx + 10, wy + 6, 4, 1);
  }

  var roofColor = dark ? "#141A33" : "#B9C7D6";
  ctx.fillStyle = roofColor;
  ctx.fillRect(wx, wy + wh - 3, 4, 3);
  ctx.fillRect(wx + 4, wy + wh - 5, 3, 5);
  ctx.fillRect(wx + 8, wy + wh - 2, 5, 2);
  ctx.fillRect(wx + 14, wy + wh - 4, 3, 4);
  ctx.fillRect(wx + 18, wy + wh - 3, 2, 3);
  if (dark) {
    ctx.fillStyle = "#FFD76A";
    ctx.fillRect(wx + 5, wy + wh - 3, 1, 1);
    ctx.fillRect(wx + 15, wy + wh - 2, 1, 1);
  }

  ctx.fillStyle = ink;
  ctx.fillRect(wx + ww / 2 - 1, wy, 1, wh);
  ctx.fillRect(wx, wy + wh / 2 - 1, ww, 1);

  var deskX = 4, deskY = h - 13, deskW = 30, deskH = 3;
  ctx.fillStyle = deskDark;
  ctx.fillRect(deskX, deskY + deskH, 2, 8);
  ctx.fillRect(deskX + deskW - 2, deskY + deskH, 2, 8);
  ctx.fillStyle = deskColor;
  ctx.fillRect(deskX, deskY, deskW, deskH);

  var monX = deskX + 4, monY = deskY - 9, monW = 12, monH = 8;
  ctx.fillStyle = monitorFrame;
  ctx.fillRect(monX, monY, monW, monH);
  ctx.fillRect(monX + monW / 2 - 1, monY + monH, 2, 1);
  ctx.fillRect(monX + monW / 2 - 3, monY + monH + 1, 6, 1);
  ctx.fillStyle = dark ? "#1C2340" : "#33447A";
  ctx.fillRect(monX, monY, monW, 1);
  ctx.fillRect(monX, monY, 1, monH);
  var glowPhase = reduceMotion ? 1 : (Math.sin(t / 700) + 1) / 2;
  var screenColor = dark ? "#0A0E1C" : "#DDEBFF";
  ctx.fillStyle = screenColor;
  ctx.fillRect(monX + 1, monY + 1, monW - 2, monH - 2);
  if (!dark) {
    ctx.fillStyle = accent;
    ctx.globalAlpha = 0.5 + glowPhase * 0.5;
    ctx.fillRect(monX + 2, monY + 2, monW - 4, 1);
    ctx.fillRect(monX + 2, monY + 6, 3, 1);
    ctx.globalAlpha = 1;
    ctx.fillStyle = led;
    ctx.globalAlpha = 0.7;
    ctx.fillRect(monX + 2, monY + 4, 6, 1);
    ctx.globalAlpha = 1;
    var cursorOn = reduceMotion ? true : (Math.floor(t / 500) % 2 === 0);
    if (cursorOn) {
      ctx.fillStyle = accent;
      ctx.fillRect(monX + 6, monY + 6, 1, 1);
    }
  }

  if (dark) {
    /* asleep in bed, monitor off */
    var bedX = 35, bedFrameY = 21;
    ctx.fillStyle = deskDark;
    ctx.fillRect(bedX - 1, 11, 3, 13);
    ctx.fillRect(bedX - 1, bedFrameY, 19, 3);
    ctx.fillStyle = "#2A3050";
    ctx.fillRect(bedX + 3, bedFrameY - 2, 14, 2);
    var bedBottom = 20;
    var blanketH = 11;
    var blanket = "#33407A", fold = "#4A5A9E";
    ctx.fillStyle = blanket;
    ctx.fillRect(bedX + 2, bedBottom - blanketH, 16, blanketH);
    ctx.fillStyle = fold;
    ctx.fillRect(bedX + 2, bedBottom - blanketH, 16, 1);
    ctx.fillStyle = "#E9DCC9";
    ctx.fillRect(bedX + 1, 12, 6, 3);
    ctx.fillStyle = ink;
    ctx.fillRect(bedX + 2, 8, 6, 5);
    ctx.fillStyle = "#E8B786";
    ctx.fillRect(bedX + 3, 9, 4, 3);
  } else {
    var chairX = deskX + deskW + 3, chairY = deskY - 11;
    ctx.fillStyle = ink;
    ctx.fillRect(chairX + 1, chairY + 6, 8, 7);
    ctx.fillRect(chairX + 2, chairY + 1, 6, 6);
    ctx.fillRect(chairX + 1, chairY, 3, 1);
    ctx.fillRect(chairX + 7, chairY + 1, 1, 2);
    ctx.fillStyle = "#3A3F5C";
    ctx.fillRect(chairX + 1, chairY + 6, 2, 7);
    ctx.fillStyle = "#E8B786";
    var blinkEye = reduceMotion ? false : (Math.floor(t / 2600) % 46 === 0);
    ctx.fillRect(chairX + 3, chairY + 2, 4, 4);
    ctx.fillRect(chairX, chairY + 12, 2, 2);
    ctx.fillRect(chairX + 7, chairY + 12, 2, 2);
    if (!blinkEye) {
      ctx.fillStyle = ink;
      ctx.fillRect(chairX + 4, chairY + 3, 1, 1);
      ctx.fillRect(chairX + 6, chairY + 3, 1, 1);
    }
    ctx.fillStyle = ink;
    ctx.fillRect(chairX + 4, chairY + 5, 3, 1);
    ctx.fillStyle = led;
    ctx.fillRect(chairX - 2, chairY + 8, 3, 5);
    ctx.fillRect(chairX + 8, chairY + 8, 3, 5);
  }

  ctx.fillStyle = ink;
  for (var lx = 0; lx < w; lx += 4) {
    ctx.fillRect(lx, h - 1, 2, 1);
  }
}

function initScene() {
  var scene = makeCanvas("scene-canvas", GRID_W, GRID_H, 6);
  var lastActiveTs = 0;
  function frame(ts) {
    if (!scenePaused) lastActiveTs = ts;
    drawScene(scene, lastActiveTs);
    if (!reduceMotion) requestAnimationFrame(frame);
  }
  if (reduceMotion) {
    drawScene(scene, 0);
  } else {
    requestAnimationFrame(frame);
  }
  var mo = new MutationObserver(function () { if (reduceMotion) drawScene(scene, 0); });
  mo.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", function () {
    if (reduceMotion) drawScene(scene, 0);
  });
}

