    toggleBtn.textContent = expanded ? content[currentLang].journey.collapseAllLabel : content[currentLang].journey.expandAllLabel;
  });
  i18nRefs.push({
    node: toggleBtn, type: "text",
    getter: function (l) { return expanded ? content[l].journey.collapseAllLabel : content[l].journey.expandAllLabel; }
  });
}

