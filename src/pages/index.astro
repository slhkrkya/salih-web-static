var SECTION_IDS = ["projects", "research", "inventory", "journey", "contact"];
function buildNav() {
  var pillMenu = document.getElementById("pill-menu");
  var dots = document.getElementById("compass-dots");
  SECTION_IDS.forEach(function (id) {
    var btn = document.createElement("button");
    btn.type = "button";
    btn.className = "pill-btn";
    btn.dataset.target = id;
    btn.setAttribute("aria-current", "false");
    bindText(btn, function (l) { return get(content[l], "nav.items." + id); });
    btn.addEventListener("click", function () { jumpTo(id); });
    pillMenu.appendChild(btn);

    var dot = document.createElement("button");
    dot.type = "button";
    dot.className = "compass-dot";
    dot.dataset.target = id;
    dot.tabIndex = -1;
    dot.addEventListener("click", function () { jumpTo(id); });
    dots.appendChild(dot);
  });
}
function jumpTo(id) {
  var target = document.getElementById(id);
  if (!target) return;
  setActiveSection(id);
  target.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "start" });
}
function setActiveSection(id) {
  document.querySelectorAll(".pill-btn").forEach(function (b) {
    b.setAttribute("aria-current", b.dataset.target === id ? "true" : "false");
  });
  document.querySelectorAll(".compass-dot").forEach(function (d) {
    d.setAttribute("aria-current", d.dataset.target === id ? "true" : "false");
  });
}
function initSectionObserver() {
  var sections = SECTION_IDS.map(function (id) { return document.getElementById(id); }).filter(Boolean);
  if (!sections.length) return;
  var navEl = document.getElementById("route-compass");
  var ticking = false;
  function computeActive() {
    ticking = false;
    var doc = document.documentElement;
    var atBottom = window.scrollY + window.innerHeight >= doc.scrollHeight - 2;
    if (atBottom) {
      setActiveSection(sections[sections.length - 1].id);
      return;
    }
    var refLine = (navEl ? navEl.getBoundingClientRect().height : 0) + 24;
    var activeId = sections[0].id;
    for (var i = 0; i < sections.length; i++) {
      if (sections[i].getBoundingClientRect().top <= refLine) {
        activeId = sections[i].id;
      } else {
        break;
      }
    }
    setActiveSection(activeId);
  }
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(computeActive);
  }
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll, { passive: true });
  computeActive();
}

/* ---------------- reveal on scroll ---------------- */
function initReveal() {
  var items = document.querySelectorAll(".reveal");
  if (reduceMotion) {
    items.forEach(function (el) { el.classList.add("is-visible"); });
    return;
  }
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry, idx) {
      if (entry.isIntersecting) {
        var delay = Math.min(idx, 6) * 50;
        entry.target.style.transitionDelay = delay + "ms";
        entry.target.classList.add("is-visible");
        io.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });
  items.forEach(function (el) { io.observe(el); });
}

