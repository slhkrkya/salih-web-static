---
const SITE_URL = (Astro.site ? Astro.site.toString() : "https://salihkarakaya.com.tr/").replace(/\/$/, "");
const pageTitle = "Salih Karakaya — Full-Stack Bilgisayar Mühendisi";
const pageDescription = "Multi-tenant SaaS ürünleri, AI agent platformları ve RAG sistemleri kuran full-stack mühendis Salih Karakaya'nın portfolyosu.";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Salih Karakaya",
  "alternateName": "slhkrkya",
  "url": SITE_URL + "/",
  "jobTitle": "Full-Stack Bilgisayar Mühendisi",
  "description": pageDescription,
  "email": "mailto:slhkrkyh@gmail.com",
  "alumniOf": {
    "@type": "CollegeOrUniversity",
    "name": "Gazi Üniversitesi"
  },
  "sameAs": [
    "https://github.com/slhkrkya",
    "https://www.linkedin.com/in/salih-karakaya-a43818299"
  ],
  "knowsAbout": [
    "Full-Stack Development",
    "Multi-tenant SaaS",
    "AI Agent Platformları",
    "RAG Sistemleri"
  ]
};
---

<!doctype html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={SITE_URL + "/"} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#1D2B53" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={SITE_URL + "/"} />
  <meta property="og:locale" content="tr_TR" />
  <meta property="og:locale:alternate" content="en_US" />
  <meta property="og:image" content={SITE_URL + "/og-image.png"} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={pageTitle} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={SITE_URL + "/og-image.png"} />

  <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>

<style is:global>
:root {
  --bg: #FFF1E8; --surface: #FFFFFF; --surface-soft: #F6E4D8;
  --ink: #1D2B53; --ink-soft: #5F574F;
  --accent: #FF3E7A; --secondary: #0091D6; --led: #14C15A;
  --accent-text: #C4185E; --link-text: #00679C;
  --shadow-hard: rgba(29, 43, 83, 0.28); --notch: 10px;
  --font-mono: ui-monospace, "Cascadia Code", "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
  --font-sans: -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}
@media (prefers-color-scheme: dark) {
  :root { --bg: #171F3D; --surface: #212a52; --surface-soft: #283163; --ink: #FDF3E9; --ink-soft: #B7B9D6; --accent: #FF6C9C; --secondary: #58C4FF; --led: #38E27C; --accent-text: #FF6C9C; --link-text: #58C4FF; --shadow-hard: rgba(0,0,0,0.45); }
}
:root[data-theme="dark"] { --bg: #171F3D; --surface: #212a52; --surface-soft: #283163; --ink: #FDF3E9; --ink-soft: #B7B9D6; --accent: #FF6C9C; --secondary: #58C4FF; --led: #38E27C; --accent-text: #FF6C9C; --link-text: #58C4FF; --shadow-hard: rgba(0,0,0,0.45); }
:root[data-theme="light"] { --bg: #FFF1E8; --surface: #FFFFFF; --surface-soft: #F6E4D8; --ink: #1D2B53; --ink-soft: #5F574F; --accent: #FF3E7A; --secondary: #0091D6; --led: #14C15A; --accent-text: #C4185E; --link-text: #00679C; --shadow-hard: rgba(29,43,83,0.28); }

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-sans);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}
img, canvas { max-width: 100%; }
.tabular { font-variant-numeric: tabular-nums; }

a { color: var(--link-text); }

.visually-hidden {
  position: absolute !important;
  width: 1px; height: 1px;
  padding: 0; margin: -1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  white-space: nowrap;
  border: 0;
}

.skip-link {
  position: absolute;
  left: 8px; top: -60px;
  background: var(--ink); color: var(--bg);
  padding: 8px 14px;
  font-family: var(--font-mono);
  font-size: 0.85rem;
  z-index: 500;
  transition: top 0.15s ease;
}
.skip-link:focus { top: 8px; }
@media (prefers-reduced-motion: reduce) {
  .skip-link { transition: none; }
}

:focus-visible {
  outline: 3px dashed var(--accent);
  outline-offset: 3px;
}
dialog:focus-visible { outline: none; }

.pixel-frame {
  clip-path: polygon(
    0 var(--notch), var(--notch) var(--notch), var(--notch) 0,
    calc(100% - var(--notch)) 0, calc(100% - var(--notch)) var(--notch), 100% var(--notch),
    100% calc(100% - var(--notch)), calc(100% - var(--notch)) calc(100% - var(--notch)), calc(100% - var(--notch)) 100%,
    var(--notch) 100%, var(--notch) calc(100% - var(--notch)), 0 calc(100% - var(--notch))
  );
  filter: drop-shadow(6px 6px 0 var(--shadow-hard));
}

.pixel-canvas { display:block; width:100%; height:auto; image-rendering: pixelated; image-rendering: crisp-edges; }

.container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 20px;
}

/* ---------- HERO ---------- */
.hero {
  padding: 28px 0 20px;
  position: relative;
}
.hero-grid {
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  gap: 28px;
  align-items: center;
}
@media (max-width: 780px) {
  .hero-grid { grid-template-columns: 1fr; }
}
.hero-id {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.eyebrow {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent-text);
  margin: 0;
}
.hero-name {
  font-size: clamp(1.9rem, 4vw, 2.7rem);
  margin: 0;
  line-height: 1.1;
  font-family: var(--font-mono);
}
.hero-title {
  margin: 0;
  font-size: 1.05rem;
  color: var(--ink-soft);
}
.hero-hook {
  margin: 6px 0 4px;
  max-width: 46ch;
  font-size: 1rem;
}
.hero-links {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 6px;
}
.icon-link {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 8px 12px;
  background: var(--surface);
  color: var(--ink);
  text-decoration: none;
  font-family: var(--font-mono);
  font-size: 0.82rem;
  border: 2px solid var(--ink);
}
.icon-link:hover { background: var(--surface-soft); }
.icon-glyph { font-family: var(--font-mono); color: var(--accent-text); }

.hero-scene-wrap {
  position: relative;
  background: var(--surface);
  padding: 14px;
  border: 2px solid var(--ink);
}
.scene-controls {
  position: absolute;
  top: 22px; right: 22px;
  z-index: 3;
}
.theme-btn {
  font-family: var(--font-mono);
  font-size: 1rem;
  background: var(--surface);
  border: 2px solid var(--ink);
  color: var(--ink);
  width: 34px; height: 34px;
  cursor: pointer;
  line-height: 1;
}
.theme-btn:hover { background: var(--surface-soft); }

.speech-bubble {
  position: absolute;
  left: 14px; right: 14px; top: 8px;
  background: var(--surface);
  border: 2px solid var(--ink);
  padding: 10px 12px;
  font-family: var(--font-mono);
  font-size: 0.82rem;
  z-index: 4;
  transition: opacity 0.25s ease, transform 0.25s ease;
}
.speech-bubble::after {
  content: "";
  position: absolute;
  left: 24px; bottom: -10px;
  width: 0; height: 0;
  border: 10px solid transparent;
  border-top-color: var(--ink);
  border-bottom: 0;
}
.speech-bubble.hidden-bubble {
  opacity: 0;
  transform: translateY(-6px);
  pointer-events: none;
}
@media (prefers-reduced-motion: reduce) {
  .speech-bubble { transition: none; }
}

.avatar-trigger {
  cursor: pointer;
  background: none;
  border: 0;
  padding: 0;
  display: block;
  width: 100%;
}

/* ---------- ROUTE COMPASS / NAV ---------- */
.route-compass {
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--surface);
  border-bottom: 2px solid var(--ink);
}
.compass-inner {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 0;
}
.pill-menu {
  display: flex;
  gap: 6px;
  flex-wrap: nowrap;
  min-width: 0;
  overflow-x: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.pill-menu::-webkit-scrollbar { display: none; }
.pill-btn {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  white-space: nowrap;
  background: transparent;
  border: 2px solid transparent;
  color: var(--ink);
  padding: 6px 10px;
  cursor: pointer;
}
.pill-btn:hover { border-color: var(--ink-soft); }
.pill-btn[aria-current="true"] {
  border-color: var(--ink);
  background: var(--surface-soft);
  color: var(--accent-text);
}
.compass-dots {
  display: flex;
  gap: 6px;
  align-items: center;
  margin-left: 4px;
}
.compass-dot {
  width: 9px; height: 9px;
  background: var(--ink-soft);
  border: 0;
  padding: 0;
  cursor: pointer;
  opacity: 0.5;
}
.compass-dot[aria-current="true"] {
  background: var(--accent);
  opacity: 1;
}
.compass-spacer { flex: 1 1 auto; min-width: 8px; }
.mini-avatar-btn {
  flex: none;
  font-family: var(--font-mono);
  font-size: 0.78rem;
  background: var(--surface-soft);
  border: 2px solid var(--ink);
  color: var(--ink);
  padding: 5px 9px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  white-space: nowrap;
}
.mini-avatar-btn:hover { background: var(--bg); }
.mini-avatar-dot {
  width: 10px; height: 10px;
  background: var(--accent);
  display: inline-block;
}
.lang-toggle {
  display: inline-flex;
  border: 2px solid var(--ink);
  font-family: var(--font-mono);
  font-size: 0.78rem;
  flex: none;
}
.lang-btn {
  background: var(--surface);
  color: var(--ink);
  border: 0;
  padding: 6px 9px;
  cursor: pointer;
}
.lang-btn + .lang-btn { border-left: 2px solid var(--ink); }
.lang-btn[aria-pressed="true"] {
  background: var(--accent-text);
  color: var(--surface);
}

/* ---------- SECTIONS GENERIC ---------- */
.section {
  padding: 46px 0;
  border-bottom: 2px dashed var(--surface-soft);
  scroll-margin-top: 56px;
}
.section:last-of-type { border-bottom: 0; }
#journey { background: var(--surface-soft); }
.section-head { max-width: 62ch; margin-bottom: 22px; }
.section-title {
  font-family: var(--font-mono);
  font-size: clamp(1.3rem, 3vw, 1.7rem);
  margin: 0 0 6px;
}
.section-sub {
  margin: 0;
  color: var(--ink-soft);
  font-size: 0.95rem;
}

.reveal {
  opacity: 0;
  transform: translateY(10px);
  transition: opacity 0.2s ease, transform 0.2s ease;
}
.reveal.is-visible { opacity: 1; transform: none; }
@media (prefers-reduced-motion: reduce) {
  .reveal { transition: none !important; opacity: 1 !important; transform: none !important; }
}

/* ---------- PROJECT SHELF ---------- */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 22px;
}
.chip {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  background: var(--surface);
  border: 2px solid var(--ink);
  color: var(--ink);
  padding: 6px 11px;
  cursor: pointer;
}
.chip:hover { background: var(--surface-soft); }
.chip[aria-pressed="true"] {
  background: var(--ink);
  color: var(--bg);
}
.tech-filter-pill {
  display: none;
  align-items: center;
  gap: 8px;
  font-family: var(--font-mono);
  font-size: 0.78rem;
  background: var(--link-text);
  color: #fff;
  padding: 6px 10px;
  margin-bottom: 18px;
}
.tech-filter-pill.active { display: inline-flex; }
.tech-filter-pill button {
  background: none;
  border: 0;
  color: #fff;
  font-family: var(--font-mono);
  font-size: 0.85rem;
  cursor: pointer;
  padding: 0 0 0 4px;
}

.project-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 18px;
  align-items: start;
}
.project-card {
  background: var(--surface);
  padding: 16px;
  min-height: 0;
}
.project-card[hidden] { display: none; }
.project-card summary {
  cursor: pointer;
  list-style: none;
  display: block;
}
.project-card summary::-webkit-details-marker { display: none; }
.card-summary-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 8px;
}
.card-title {
  font-family: var(--font-mono);
  font-size: 1rem;
  margin: 0 0 4px;
}
.card-meta {
  font-size: 0.78rem;
  color: var(--ink-soft);
  margin: 0 0 8px;
  font-family: var(--font-mono);
}
.card-badges { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 8px; }
.tech-badge {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  background: var(--surface-soft);
  color: var(--ink);
  padding: 2px 7px;
  border: 1px solid var(--ink-soft);
}
.status-badge {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  padding: 2px 7px;
  border: 1px solid var(--ink);
}
.status-badge.new { background: var(--led); color: #06210f; }
.status-badge.locked { background: var(--surface-soft); color: var(--ink-soft); }
.card-summary-text { margin: 6px 0 4px; font-size: 0.9rem; }
.details-toggle-hint {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--link-text);
}
.project-card[open] .details-toggle-hint::before { content: "▾ "; }
.project-card:not([open]) .details-toggle-hint::before { content: "▸ "; }
.card-detail-list {
  margin: 12px 0 0;
  padding-left: 18px;
  font-size: 0.86rem;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.card-link-row { margin-top: 10px; }
.card-link {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: var(--link-text);
  text-decoration: underline;
  text-underline-offset: 2px;
}
.card-link:hover { text-decoration-thickness: 2px; }

.no-matches {
  display: none;
  padding: 30px 16px;
  text-align: center;
  background: var(--surface);
  border: 2px dashed var(--ink-soft);
  font-family: var(--font-mono);
}
.no-matches.show { display: block; }
.no-matches-title { font-size: 1rem; margin: 0 0 6px; }
.no-matches-body { margin: 0; color: var(--ink-soft); font-size: 0.85rem; }

/* ---------- RESEARCH / BOSS LEVEL ---------- */
#research { background: var(--surface-soft); }
.boss-panel {
  background: var(--surface);
  padding: 22px;
}
.boss-meta-row {
  display: flex; flex-wrap: wrap; gap: 14px;
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: var(--ink-soft);
  margin-bottom: 14px;
}
.boss-tech-row { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 20px; }
.stat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
  margin-bottom: 24px;
}
.stat-block { }
.stat-label {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--ink-soft);
  margin: 0 0 8px;
}
.stat-bars { display: flex; flex-direction: column; gap: 8px; }
.stat-bar-row { display: flex; align-items: center; gap: 10px; }
.stat-bar-track {
  flex: 1;
  height: 14px;
  background: var(--surface-soft);
  position: relative;
  overflow: hidden;
}
.stat-bar-fill {
  height: 100%;
  width: 0%;
  transition: width 0.7s ease;
}
.stat-bar-fill.before { background: var(--accent); }
.stat-bar-fill.after { background: var(--led); }
@media (prefers-reduced-motion: reduce) {
  .stat-bar-fill { transition: none; }
}
.stat-bar-value {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  width: 64px;
  text-align: right;
  flex: none;
}
.f1-value {
  font-family: var(--font-mono);
  font-size: 2.1rem;
  margin: 0;
}
.flow-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin-bottom: 18px;
}
.flow-box {
  font-family: var(--font-mono);
  font-size: 0.76rem;
  background: var(--surface-soft);
  border: 2px solid var(--ink);
  padding: 8px 12px;
  text-align: center;
}
.flow-arrow { color: var(--ink-soft); font-family: var(--font-mono); }
.result-summary { font-size: 0.92rem; margin: 0 0 14px; }
.method-details summary {
  cursor: pointer;
  font-family: var(--font-mono);
  font-size: 0.82rem;
  color: var(--link-text);
}
.method-details p { font-size: 0.86rem; margin: 8px 0 0; }

/* ---------- INVENTORY ---------- */
.tablist { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }
.tab-btn {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  background: var(--surface);
  border: 2px solid var(--ink);
  color: var(--ink);
  padding: 7px 12px;
  cursor: pointer;
}
.tab-btn:hover { background: var(--surface-soft); }
.tab-btn[aria-selected="true"] { background: var(--ink); color: var(--bg); }
.tabpanel[hidden] { display: none; }
.skill-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.skill-chip {
  font-family: var(--font-mono);
  font-size: 0.82rem;
  background: var(--surface);
  border: 2px solid var(--ink-soft);
  color: var(--ink);
  padding: 6px 11px;
  cursor: pointer;
}
.skill-chip:hover { border-color: var(--accent-text); color: var(--accent-text); }
.skill-chip-more {
  background: var(--surface-soft);
  border-style: dashed;
  color: var(--link-text);
}

/* ---------- JOURNEY ---------- */
.journey-controls { margin-bottom: 14px; }
.expand-toggle-btn {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  background: var(--surface);
  border: 2px solid var(--ink);
  color: var(--ink);
  padding: 7px 12px;
  cursor: pointer;
}
.expand-toggle-btn:hover { background: var(--surface-soft); }
.journey-list { display: flex; flex-direction: column; gap: 10px; }
.journey-row {
  background: var(--surface);
  padding: 10px 14px;
}
.journey-row summary {
  cursor: pointer;
  list-style: none;
  display: flex;
  align-items: baseline;
  gap: 8px;
  font-family: var(--font-mono);
  font-size: 0.84rem;
  flex-wrap: wrap;
}
.journey-row summary::-webkit-details-marker { display: none; }
.journey-row summary::before { content: "▸ "; color: var(--ink-soft); }
.journey-row[open] summary::before { content: "▾ "; }
.j-role { font-weight: 600; margin: 0; font-size: inherit; font-family: inherit; display: inline; }
.j-company { color: var(--link-text); }
.j-dates { color: var(--ink-soft); margin-left: auto; }
.journey-bullets {
  margin: 10px 0 2px;
  padding-left: 18px;
  font-size: 0.86rem;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

/* ---------- CHARACTER DIALOG ---------- */
dialog.character-dialog {
  border: 2px solid var(--ink);
  background: var(--surface);
  color: var(--ink);
  padding: 0;
  max-width: 560px;
  width: min(92vw, 560px);
  max-height: 84vh;
  overflow: auto;
}
dialog.character-dialog::backdrop {
  background: rgba(20,20,30,0.55);
}
.dialog-inner { padding: 22px; }
.dialog-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 10px;
  margin-bottom: 14px;
}
.dialog-title { font-family: var(--font-mono); font-size: 1.2rem; margin: 0 0 4px; }
.dialog-sub { margin: 0; color: var(--ink-soft); font-size: 0.85rem; }
.dialog-close-btn {
  font-family: var(--font-mono);
  background: var(--surface);
  border: 2px solid var(--ink);
  color: var(--ink);
  width: 32px; height: 32px;
  cursor: pointer;
  flex: none;
}
.dialog-close-btn:hover { background: var(--surface-soft); }
.stat-line {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  font-family: var(--font-mono);
