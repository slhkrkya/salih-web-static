    bindText(title, makeProjectGetter(p.id, "title"));
    var meta = makeEl("p", "card-meta tabular");
    bindText(meta, makeProjectGetter(p.id, "meta"));
    titleWrap.appendChild(title);
    titleWrap.appendChild(meta);
    top.appendChild(titleWrap);
    if (p.badge) {
      var badge = makeEl("span", "status-badge new");
      bindText(badge, function (l) { return get(content[l], "projectShelf.badges." + p.badge); });
      top.appendChild(badge);
    }
    summary.appendChild(top);

    var badgesRow = makeEl("div", "card-badges");
    p.techBadges.forEach(function (tb) { badgesRow.appendChild(makeEl("span", "tech-badge", tb)); });
    summary.appendChild(badgesRow);

    var summaryText = makeEl("p", "card-summary-text");
    bindText(summaryText, makeProjectGetter(p.id, "summary"));
    summary.appendChild(summaryText);

    var hint = makeEl("span", "details-toggle-hint");
    bindText(hint, function (l) { return get(content[l], "projectShelf.detailsToggleLabel"); });
    summary.appendChild(hint);

    card.appendChild(summary);

    var detailList = makeEl("ul", "card-detail-list");
    p.details.forEach(function (d, idx) {
      var li = document.createElement("li");
      bindText(li, function (l) {
        var proj = content[l].projectShelf.projects.find(function (x) { return x.id === p.id; });
        return proj.details[idx];
      });
      detailList.appendChild(li);
    });
    card.appendChild(detailList);

    var linkRow = makeEl("div", "card-link-row");
    if (p.link.type === "github") {
      var a = document.createElement("a");
      a.className = "card-link";
      a.href = p.link.url;
      a.target = "_blank";
      a.rel = "noopener noreferrer";
      bindText(a, function (l) { return "↗ " + get(content[l], "projectShelf.openSourceLinkLabel"); });
      linkRow.appendChild(a);
    } else {
      var lockBadge = makeEl("span", "status-badge locked");
      bindText(lockBadge, function (l) { return get(content[l], "projectShelf.badges.workBadge"); });
      linkRow.appendChild(lockBadge);
    }
    card.appendChild(linkRow);

    card.addEventListener("toggle", updateScenePauseState);

    grid.appendChild(card);
  });
}
function makeProjectGetter(id, field) {
  return function (l) {
    var proj = content[l].projectShelf.projects.find(function (x) { return x.id === id; });
    return proj ? proj[field] : "";
  };
}

/* ---------------- research / boss level ---------------- */
function buildResearch() {
  var techRow = document.getElementById("research-tech-row");
  content.tr.research.tech.forEach(function (t) { techRow.appendChild(makeEl("span", "tech-badge", t)); });

  var flowRow = document.getElementById("research-flow-row");
  content.tr.research.flow.steps.forEach(function (step, idx) {
    var box = makeEl("span", "flow-box");
    bindText(box, function (l) { return content[l].research.flow.steps[idx]; });
    flowRow.appendChild(box);
    if (idx < content.tr.research.flow.steps.length - 1) {
      var arrow = makeEl("span", "flow-arrow", "→");
      arrow.setAttribute("aria-hidden", "true");
      flowRow.appendChild(arrow);
    }
