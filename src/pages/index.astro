var FILTER_KEYS = ["all", "backend", "frontend", "architectureSecurity", "aiml", "workProjects", "openSource", "academic"];
var selectedFilters = new Set();
var techFilter = null;

function buildFilterChips() {
  var row = document.getElementById("filter-chip-row");
  row.setAttribute("role", "toolbar");
  row.setAttribute("aria-orientation", "horizontal");
  FILTER_KEYS.forEach(function (key, idx) {
    var chip = document.createElement("button");
    chip.type = "button";
    chip.className = "chip";
    chip.dataset.key = key;
    chip.tabIndex = idx === 0 ? 0 : -1;
    chip.setAttribute("aria-pressed", key === "all" ? "true" : "false");
    bindText(chip, function (l) { return get(content[l], "projectShelf.filters." + key); });
    chip.addEventListener("click", function () { toggleFilter(key); });
    row.appendChild(chip);
  });
  row.addEventListener("keydown", function (e) {
    var chips = Array.prototype.slice.call(row.querySelectorAll(".chip"));
    var idx = chips.indexOf(document.activeElement);
    if (idx === -1) return;
    var newIdx = idx;
    if (e.key === "ArrowRight") newIdx = (idx + 1) % chips.length;
    else if (e.key === "ArrowLeft") newIdx = (idx - 1 + chips.length) % chips.length;
    else if (e.key === "Home") newIdx = 0;
    else if (e.key === "End") newIdx = chips.length - 1;
    else return;
    e.preventDefault();
    chips[idx].tabIndex = -1;
    chips[newIdx].tabIndex = 0;
    chips[newIdx].focus();
  });
  row.addEventListener("focusin", function (e) {
    var chips = Array.prototype.slice.call(row.querySelectorAll(".chip"));
    chips.forEach(function (c) { c.tabIndex = c === e.target ? 0 : -1; });
  });
}
function toggleFilter(key) {
  if (key === "all") {
    selectedFilters.clear();
  } else {
    if (selectedFilters.has(key)) selectedFilters.delete(key);
    else selectedFilters.add(key);
  }
  refreshFilterChipStates();
  applyProjectFilters();
}
function refreshFilterChipStates() {
  document.querySelectorAll(".chip").forEach(function (chip) {
    var key = chip.dataset.key;
    var pressed = key === "all" ? selectedFilters.size === 0 : selectedFilters.has(key);
    chip.setAttribute("aria-pressed", pressed ? "true" : "false");
  });
}
function clearTechFilter() {
  techFilter = null;
  document.getElementById("tech-filter-pill").classList.remove("active");
  applyProjectFilters();
}
function setTechFilter(name) {
  techFilter = name;
  var pill = document.getElementById("tech-filter-pill");
  pill.classList.add("active");
  document.getElementById("tech-filter-label").textContent = name;
  applyProjectFilters();
  jumpTo("projects");
}
function applyProjectFilters() {
  var cards = document.querySelectorAll(".project-card");
  var visibleCount = 0;
  cards.forEach(function (card) {
    var tags = JSON.parse(card.dataset.tags || "[]");
    var tech = JSON.parse(card.dataset.tech || "[]");
    var categoryPass = selectedFilters.size === 0 || tags.some(function (t) { return selectedFilters.has(t); });
    var techPass = !techFilter || tech.indexOf(techFilter) !== -1;
    var show = categoryPass && techPass;
    card.hidden = !show;
    if (show) visibleCount++;
  });
  document.getElementById("no-matches").classList.toggle("show", visibleCount === 0);
  var announcer = document.getElementById("a11y-announcer");
  if (announcer) {
    if (visibleCount === 0) {
      announcer.textContent = get(content[currentLang], "projectShelf.noMatches.title");
    } else {
      announcer.textContent = currentLang === "tr" ? (visibleCount + " proje bulundu") : (visibleCount + " projects found");
    }
  }
}

function buildProjectCards() {
  var grid = document.getElementById("project-grid");
