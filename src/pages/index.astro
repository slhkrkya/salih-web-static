function buildCharacterDialog() {
  bindText(document.getElementById("edu-school-label"), function (l) { return content[l].characterSheet.education.school; });
  bindText(document.getElementById("edu-degree"), function (l) { return content[l].characterSheet.education.degree; });
  bindText(document.getElementById("edu-gpa"), function (l) { return content[l].characterSheet.education.gpa; });
  bindText(document.getElementById("edu-grad-label"), function (l) { return l === "tr" ? "Mezuniyet" : "Graduation"; });
  bindText(document.getElementById("edu-gpa-label"), function (l) { return l === "tr" ? "GNO" : "GPA"; });
  bindText(document.getElementById("edu-grad"), function (l) { return content[l].characterSheet.education.graduation; });
  bindText(document.getElementById("lang-name"), function (l) { return content[l].characterSheet.language.name; });
  bindText(document.getElementById("lang-level"), function (l) { return content[l].characterSheet.language.level; });

  function renderDocList(containerId, sectionKey) {
    var listEl = document.getElementById(containerId);
    content.tr.characterSheet[sectionKey].forEach(function (item, idx) {
      var li = makeEl("li", "cert-item");
      var link = document.createElement("a");
      link.className = "cert-link";
      link.href = item.href;
      link.target = "_blank";
      link.rel = "noopener noreferrer";
      var medal = makeEl("span", "cert-medal");
      medal.setAttribute("aria-hidden", "true");
      var textWrap = document.createElement("div");
      var titleEl = makeEl("p", "cert-text");
      bindText(titleEl, function (l) { return content[l].characterSheet[sectionKey][idx].title; });
      var issuerEl = makeEl("p", "cert-issuer");
      bindText(issuerEl, function (l) {
        var c = content[l].characterSheet[sectionKey][idx];
        return c.issuer + " · " + c.year;
      });
      var hintEl = makeEl("p", "cert-preview-hint");
      bindText(hintEl, function (l) { return (l === "tr" ? "PDF olarak önizle" : "Preview as PDF") + " " + get(content[l], "common.newTabHint"); });
      i18nRefs.push({ node: link, type: "attr", attr: "title", getter: function (l) {
        var c = content[l].characterSheet[sectionKey][idx];
        return c.issuer + " (" + c.year + ")";
      }});
      textWrap.appendChild(titleEl);
      textWrap.appendChild(issuerEl);
      textWrap.appendChild(hintEl);
      link.appendChild(medal);
      link.appendChild(textWrap);
      li.appendChild(link);
      listEl.appendChild(li);
    });
  }
  renderDocList("cert-list", "certificates");
  renderDocList("reference-list", "references");

  var dialog = document.getElementById("character-dialog");
  var lastTrigger = null;
  function openDialog(trigger) {
    lastTrigger = trigger;
    if (typeof dialog.showModal === "function") dialog.showModal();
    else dialog.setAttribute("open", "");
    updateScenePauseState();
  }
  function closeDialog() {
    if (typeof dialog.close === "function") dialog.close();
    else dialog.removeAttribute("open");
  }
  document.getElementById("hero-avatar-btn").addEventListener("click", function (e) { openDialog(e.currentTarget); });
  document.getElementById("nav-character-btn").addEventListener("click", function (e) { openDialog(e.currentTarget); });
  document.getElementById("dialog-close-btn").addEventListener("click", closeDialog);
  dialog.addEventListener("click", function (e) { if (e.target === dialog) closeDialog(); });
  dialog.addEventListener("close", function () {
    updateScenePauseState();
    if (lastTrigger) lastTrigger.focus();
  });
}

function updateScenePauseState() {
  var dialog = document.getElementById("character-dialog");
  var anyCardOpen = Array.prototype.some.call(document.querySelectorAll(".project-card"), function (c) { return c.open; });
  scenePaused = dialog.open || anyCardOpen;
}

